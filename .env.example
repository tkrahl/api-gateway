# DonaTrack API Gateway — variables para Render
# Importar desde: Render Dashboard → Service → Environment → "Import from .env"
# Copiá este archivo a .env y reemplazá DDAPI con tu API key real.

# --- Backends (URLs de producción del grupo) ---
DYE_URL=https://donadores-entidades.onrender.com
DONACIONES_URL=https://donaciones-dgs7.onrender.com
LOGISTICA_URL=https://logisticaweb.onrender.com
INCENTIVOS_URL=https://incentivos-movn.onrender.com

# --- Métricas Datadog ---
DDAPI=REEMPLAZAR_CON_TU_DDAPI_KEY

# --- Ambiente (tag en métricas) ---
APP_ENV=produccion

# --- Rate limit (por IP, in-memory) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120

# --- CORS (* = cualquier origen; útil para bot Telegram local) ---
CORS_ALLOWED_ORIGINS=*
